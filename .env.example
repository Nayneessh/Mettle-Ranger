# Copy to .env and fill in locally. .env is git-ignored and must stay that way.
# CI reads these from GitHub Actions secrets, never from a committed file.

# Supabase (Sprint 11 — auth plus one-way log backup, no video)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AdMob (Sprint 13 — test unit IDs during development, real IDs only at launch)
ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=

# RevenueCat (Sprint 13 — remove-ads IAP)
REVENUECAT_PUBLIC_KEY=
